Subject: [PATCH] config: reject too long device names; flash: close image on bad magic

envmon/ の「最新のリビジョン」を作るためのパッチ。パスは envmon/ からの相対（a/ b/ 付き）。
  - envmon/ を最上位にしたリポジトリ（または git の外）で:  git apply envmon-latest.patch
  - plugin-market-place の中で当てるときは最上位から:
      git apply --directory=plugins/coverity-warning-triage/tests/fixtures/envmon <このファイル>
    （envmon/ の中で git apply すると、何も当てずに終わる）

diff --git a/src/app/config_ini.c b/src/app/config_ini.c
--- a/src/app/config_ini.c
+++ b/src/app/config_ini.c
@@ -300,7 +300,12 @@
     /* [device] */
     v = ini_get(doc, "device", "name");
     if (v != NULL) {
-        strcpy(cfg->device_name, v);
+        if (strlen(v) >= sizeof(cfg->device_name)) {
+            LOG_E(TAG, "[device] name: too long (max %u chars)",
+                  (unsigned)(sizeof(cfg->device_name) - 1U));
+            return EM4_ERR_RANGE;
+        }
+        (void)str_copy(cfg->device_name, sizeof(cfg->device_name), v);
     }
     u = cfg->device_id;
     rc = get_u32_range(doc, "device", "id", 1U, 0xFFFFU, &u);
diff --git a/src/drivers/flash_store.c b/src/drivers/flash_store.c
--- a/src/drivers/flash_store.c
+++ b/src/drivers/flash_store.c
@@ -353,6 +353,7 @@
         return EM4_ERR_IO;
     }
     if (tmp.magic != FLASH_MAGIC) {
+        (void)fclose(fp);
         return EM4_ERR_FORMAT;
     }
     if (tmp.hdr_crc != flash_hdr_crc(&tmp)) {
