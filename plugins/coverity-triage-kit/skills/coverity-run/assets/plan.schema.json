{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "同じ原因の統合の計画（integration/plan.json）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "merges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/merge"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S",
      "description": "空白だけでない文字列"
    },
    "recommendation": {
      "enum": [
        "fix",
        "deviation"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/text",
          "description": "リポジトリからのパス"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judgement",
        "summary",
        "rationale"
      ],
      "properties": {
        "judgement": {
          "enum": [
            "false_positive",
            "true_bug",
            "intentional",
            "undetermined"
          ]
        },
        "summary": {
          "$ref": "#/$defs/text",
          "description": "40文字ほどの要約"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "action",
        "comment"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/text"
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "severity": {
          "type": "string",
          "default": "Unspecified"
        },
        "comment": {
          "$ref": "#/$defs/text",
          "maxLength": 200,
          "description": "逸脱コメント（前後の空白を除いて200文字以内）"
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "action",
        "summary",
        "impact"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/text"
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "severity": {
          "type": "string",
          "default": "Unspecified"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "$ref": "#/$defs/text"
        },
        "exceeded_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "already_fixed_on_latest": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "revision_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "detected",
            "unknown"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "merged_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "recommendation",
        "confidence",
        "confidence_reason",
        "deviation",
        "fix",
        "revision_drift"
      ],
      "properties": {
        "item": {
          "$ref": "#/$defs/text",
          "description": "作業の ID（CID か G1 などのグループの ID）"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "confidence_reason": {
          "$ref": "#/$defs/text"
        },
        "deviation": {
          "$ref": "#/$defs/deviation"
        },
        "fix": {
          "$ref": "#/$defs/fix"
        },
        "revision_drift": {
          "$ref": "#/$defs/revision_drift"
        },
        "group_excluded_cids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "グループの中で、同じ理由に当たらず外した CID（グループのときだけ）"
        }
      },
      "description": "まとめた結果（result.json から item と group_excluded_cids を除いたもの。書いてもよい）"
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members",
        "reason",
        "fix_source",
        "result"
      ],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "同じ原因の、終わった作業の ID"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "fix_source": {
          "type": "string",
          "pattern": "^(item:\\S+|combine|rework)$",
          "description": "item:<ID>＝その作業の修正を使う、combine＝修正を合わせる、rework＝作り直す"
        },
        "result": {
          "$ref": "#/$defs/merged_result"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "note"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
